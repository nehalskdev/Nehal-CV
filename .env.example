# Public URL of the deployed site (used for canonical URLs, sitemap, OG images)
NEXT_PUBLIC_SITE_URL=https://nehal-portfolio-yiha.vercel.app

# Optional: enables the contact form to send email directly via Resend (https://resend.com).
# Without it, the form validates and falls back to opening the visitor's email client.
RESEND_API_KEY=
CONTACT_TO_EMAIL=nehal4dev@gmail.com
